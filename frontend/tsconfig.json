{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "preserve",
    "allowJs": true,
    "skipLibCheck": true,
    "paths": {
      "@/*": ["./src/*"],
      "cn": ["./src/lib/utils.ts"]
    }
  },
  "include": ["src/**/*", "tests/**/*", "vite.config.ts", "playwright.config.ts"]
}
